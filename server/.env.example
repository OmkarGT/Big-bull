# Copy this file to .env and fill in real values. Never commit .env.

# Server port
PORT=5000

# MySQL connection string
DATABASE_URL=mysql://root:yourpassword@localhost:3306/big_bull

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Simulated price engine tick interval in milliseconds
PRICE_ENGINE_INTERVAL_MS=7000

# How many hours of simulated price history to keep. The engine writes 12 rows
# per tick, so this is what stops price_history from filling the MySQL volume.
PRICE_HISTORY_RETENTION_HOURS=6
